# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored and must never be committed.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only Supabase service role key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers -> API keys, TEST mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (from the Stripe CLI or Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
